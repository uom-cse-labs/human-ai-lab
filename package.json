{
  "name": "human-ai-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w @hai/web",
    "build": "npm run build -w @hai/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contracts:generate": "npm run generate -w @hai/content-schema",
    "diagrams": "node docs/architecture/diagrams/technical-design/build.mjs",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
